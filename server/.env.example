GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

FIREBASE_PROJECT_ID=

# Local development: path to service account JSON file
GOOGLE_APPLICATION_CREDENTIALS=serviceAccountKey.json

# Production (Render etc.): paste full JSON contents on a single line.
# When set, this overrides GOOGLE_APPLICATION_CREDENTIALS.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Comma-separated allowlist. Leave empty to allow all origins (dev only).
# Wildcard "*.vercel.app" allows any Vercel preview/production domain.
CORS_ORIGINS=

PORT=4000
RATE_LIMIT_ENABLED=false
RATE_LIMIT_MAX=60
