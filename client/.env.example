# API base URL (include /api/analyze path)
VITE_API_URL=http://localhost:4000/api/analyze

# Firebase Web app config (Firebase Console → Project settings → Your apps)
# Required for authentication. Enable Email/Password + Google in Authentication → Sign-in method.
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef
